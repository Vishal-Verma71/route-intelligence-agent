# Optional LLM backend. Leave empty to use the offline deterministic agent router.
LLM_PROVIDER=auto
GROQ_API_KEY=
OPENAI_API_KEY=
# Ollama local
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
# Set to 1 to force offline fallbacks for routing/weather/geocoding (used by tests)
ROUTE_OFFLINE=0
